# Proveedor LLM: Groq (tres modelos, cuotas diarias separadas)
# No usar modelos de razonamiento en FILTER_MODEL/LLM_MODEL: medido +41% de tokens
# por llamada para el mismo trabajo (cadena de pensamiento oculta).
GROQ_API_KEY=""
FILTER_MODEL="llama-3.1-8b-instant"  # clasificación: relevancia + dedup (500K TPD, la etapa de más volumen)
LLM_MODEL="llama-3.3-70b-versatile"  # redacción de párrafos: la etapa que define la calidad (100K TPD)
EDITORIAL_MODEL="openai/gpt-oss-120b"  # revisión editorial final (modelo de razonamiento)
VOLUME_FALLBACK="llama-3.1-8b-instant"  # fallback si LLM_MODEL agota TPD (500K TPD, non-reasoning, rápido)
REASONING_FALLBACK="openai/gpt-oss-20b"  # fallback si EDITORIAL_MODEL agota TPD
TTS_VOICE="es-CR-MariaNeural"

# SMTP — Opción A: Gmail (recomendado para uso personal)
# Requiere 2FA activado + Contraseña de Aplicación desde https://myaccount.google.com/security/app-passwords
# IMPORTANTE: la contraseña de aplicación debe incluir los espacios tal como se muestran
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="tu_correo@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"

# SMTP — Opción B: Brevo (para mayor volumen o dominio verificado)
# SMTP_SERVER="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USERNAME="xxx@smtp-brevo.com"
# SMTP_PASSWORD="xsmtpsib-..."

EMAIL_FROM="tu_correo@gmail.com"
EMAIL_TO="tu_correo@live.com"
